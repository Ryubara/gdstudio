[gd_scene format=3]

[ext_resource type="Script" path="res://core/settings/settings_service.gd" id="1_service"]
[ext_resource type="Script" path="res://core/settings/quality_preset.gd" id="2_preset"]

[sub_resource type="Resource" id="Resource_low"]
script = ExtResource("2_preset")
title = "Low"
msaa = 0
shadow_atlas_size = 2048
shadow_filter = 0

[sub_resource type="Resource" id="Resource_medium"]
script = ExtResource("2_preset")
title = "Medium"
