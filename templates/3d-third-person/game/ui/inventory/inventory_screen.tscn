theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 8

[node name="Hotbar" type="HBoxContainer" parent="Fit/Margin/Center/Card/Row/Side/Scroll/Lists/HotbarMargin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="ItemsCaption" type="Label" parent="Fit/Margin/Center/Card/Row/Side/Scroll/Lists"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("4_label")
text = "BAG"
style = 5

[node name="Grid" type="GridContainer" parent="Fit/Margin/Center/Card/Row/Side/Scroll/Lists"]
unique_name_in_owner = true
