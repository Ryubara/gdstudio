[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud/hud_stat.gd" id="1_stat"]

[node name="HudStat" type="PanelContainer" node_paths=PackedStringArray("title_label", "value_label", "bar")]
custom_minimum_size = Vector2(220, 0)
mouse_filter = 2
theme_type_variation = &"HudCard"
script = ExtResource("1_stat")
title_label = NodePath("Column/Title")
value_label = NodePath("Column/Value")
bar = NodePath("Column/Bar")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"HudCaption"
text = "Health"

[node name="Value" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"HudNumber"
text = "100 / 100"

[node name="Bar" type="ProgressBar" parent="Column"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
mouse_filter = 2
value = 100.0
show_percentage = false
