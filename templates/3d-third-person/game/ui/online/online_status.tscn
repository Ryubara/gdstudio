[gd_scene format=3]

[ext_resource type="Script" path="res://ui/online/online_status.gd" id="1_status"]
[ext_resource type="Script" path="res://ui/menus/menu_fit.gd" id="2_fit"]
[ext_resource type="Script" path="res://addons/gds_ui/components/ui_panel.gd" id="3_panel"]
[ext_resource type="Script" path="res://addons/gds_ui/components/ui_label.gd" id="4_label"]
[ext_resource type="Script" path="res://addons/gds_ui/components/ui_button.gd" id="5_button"]

[node name="OnlineStatus" type="CanvasLayer"]
layer = 20
script = ExtResource("1_status")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Fit" type="Control" parent="Root"]
mouse_filter = 2
script = ExtResource("2_fit")

[node name="Center" type="CenterContainer" parent="Root/Fit"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Root/Fit/Center"]
unique_name_in_owner = true
script = ExtResource("3_panel")
variant = 2

[node name="Column" type="VBoxContainer" parent="Root/Fit/Center/Panel"]
custom_minimum_size = Vector2(560, 0)
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Root/Fit/Center/Panel/Column"]
unique_name_in_owner = true
script = ExtResource("4_label")
text = "Connecting"
horizontal_alignment = 1
style = 1

[node name="Message" type="Label" parent="Root/Fit/Center/Panel/Column"]
unique_name_in_owner = true
script = ExtResource("4_label")
horizontal_alignment = 1
autowrap_mode = 3
style = 4

[node name="ReloadButton" type="Button" parent="Root/Fit/Center/Panel/Column"]
unique_name_in_owner = true
script = ExtResource("5_button")
text = "Reload"
variant = 0

[node name="BackButton" type="Button" parent="Root/Fit/Center/Panel/Column"]
unique_name_in_owner = true
script = ExtResource("5_button")
text = "Back to menu"
variant = 1
