[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/pause_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://ui/menus/menu_fit.gd" id="2_fit"]
[ext_resource type="Script" path="res://addons/gds_ui/components/ui_panel.gd" id="3_panel"]
[ext_resource type="Script" path="res://addons/gds_ui/components/ui_label.gd" id="4_label"]
[ext_resource type="Script" path="res://addons/gds_ui/components/ui_button.gd" id="5_button"]

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
back_closes = true
stars = false
self_modulate = Color(1, 1, 1, 0.82)
script = ExtResource("1_menu")

[node name="Fit" type="Control" parent="."]
script = ExtResource("2_fit")

[node name="Center" type="CenterContainer" parent="Fit"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Fit/Center"]
variant = 2
script = ExtResource("3_panel")

[node name="Column" type="VBoxContainer" parent="Fit/Center/Panel"]
custom_minimum_size = Vector2(560, 0)
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Fit/Center/Panel/Column"]
unique_name_in_owner = true
text = "Paused"
horizontal_alignment = 1
style = 1
script = ExtResource("4_label")

[node name="ResumeButton" type="Button" parent="Fit/Center/Panel/Column"]
unique_name_in_owner = true
text = "Resume"
variant = 0
script = ExtResource("5_button")

[node name="SettingsButton" type="Button" parent="Fit/Center/Panel/Column"]
unique_name_in_owner = true
text = "Settings"
variant = 1
script = ExtResource("5_button")

[node name="MainMenuButton" type="Button" parent="Fit/Center/Panel/Column"]
unique_name_in_owner = true
text = "Main menu"
variant = 1
script = ExtResource("5_button")
