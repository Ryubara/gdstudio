[gd_resource type="Resource" script_class="AiRelations" format=3]

[ext_resource type="Script" path="res://gameplay/ai/relations/ai_relations.gd" id="1_relations"]
[ext_resource type="Script" path="res://gameplay/ai/relations/ai_faction.gd" id="2_faction"]
[ext_resource type="Script" path="res://gameplay/ai/relations/ai_relation_event.gd" id="3_event"]

[sub_resource type="Resource" id="Resource_player"]
script = ExtResource("2_faction")
id = &"player"
color = Color(0.2, 0.55, 1, 1)
hurts_friends = true
attitudes = Dictionary[StringName, int]({
&"ally": 80,
&"civilian": 20,
&"enemy": -100,
&"player": 100
})

[sub_resource type="Resource" id="Resource_enemy"]
script = ExtResource("2_faction")
id = &"enemy"
color = Color(0.9, 0.15, 0.1, 1)
attitudes = Dictionary[StringName, int]({
&"ally": -100,
&"civilian": -30,
&"enemy": 100,
&"player": -100
})

[sub_resource type="Resource" id="Resource_ally"]
script = ExtResource("2_faction")
id = &"ally"
color = Color(0.35, 0.85, 0.3, 1)
attitudes = Dictionary[StringName, int]({
&"ally": 100,
&"civilian": 30,
&"enemy": -100,
&"player": 80
})

[sub_resource type="Resource" id="Resource_civilian"]
script = ExtResource("2_faction")
id = &"civilian"
color = Color(0.85, 0.85, 0.8, 1)
attitudes = Dictionary[StringName, int]({
&"ally": 30,
&"civilian": 60,
&"enemy": -50,
&"player": 20
})

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("3_event")
id = &"attack"
delta = -30

[sub_resource type="Resource" id="Resource_kill"]
script = ExtResource("3_event")
id = &"kill"
delta = -60

[sub_resource type="Resource" id="Resource_help"]
script = ExtResource("3_event")
id = &"help"
delta = 10

[sub_resource type="Resource" id="Resource_trespass"]
script = ExtResource("3_event")
id = &"trespass"
delta = -10

[resource]
script = ExtResource("1_relations")
factions = Array[ExtResource("2_faction")]([SubResource("Resource_player"), SubResource("Resource_enemy"), SubResource("Resource_ally"), SubResource("Resource_civilian")])
events = Array[ExtResource("3_event")]([SubResource("Resource_attack"), SubResource("Resource_kill"), SubResource("Resource_help"), SubResource("Resource_trespass")])
