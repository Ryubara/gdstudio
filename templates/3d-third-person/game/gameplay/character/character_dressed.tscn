[node name="CharacterDressed" node_paths=PackedStringArray("model", "ragdoll_body") instance=ExtResource("1_character")]
model = NodePath("Model")
ragdoll_body = NodePath("Ragdoll")

[node name="Model" type="Node3D" parent="." index="1"]
script = ExtResource("2_model")

[node name="Mannequin" parent="Model" instance=ExtResource("3_mannequin")]

[node name="PistolHeld" parent="Model" instance=ExtResource("4_pistol")]
use_external_skeleton = true
external_skeleton = NodePath("../Mannequin/Armature/Skeleton3D")

[node name="AnimationPlayer" type="AnimationPlayer" parent="." index="4"]
root_node = NodePath("../Model/Mannequin")
libraries = {
&"ual1": ExtResource("5_ual1"),
&"ual2": ExtResource("6_ual2")
}

[node name="AnimationTree" type="AnimationTree" parent="." index="5"]

[node name="Animation" type="Node" parent="." index="6" node_paths=PackedStringArray("character", "model", "animation_player", "tree")]
script = ExtResource("7_animation")
character = NodePath("..")
model = NodePath("../Model")
animation_player = NodePath("../AnimationPlayer")
tree = NodePath("../AnimationTree")

[node name="Weapon" parent="." node_paths=PackedStringArray("muzzle")]
