[gd_scene format=3]

[ext_resource type="PackedScene" path="res://world/world.tscn" id="1_world"]
[ext_resource type="PackedScene" path="res://ui/player_rig/player_rig.tscn" id="2_rig"]
[ext_resource type="Script" path="res://gameplay/net/remote_players.gd" id="3_remote"]
[ext_resource type="Script" path="res://gameplay/net/net_client.gd" id="4_client"]

[node name="OnlineArena" type="Node"]

[node name="World" parent="." instance=ExtResource("1_world")]

[node name="PlayerRig" parent="." instance=ExtResource("2_rig")]

[node name="RemotePlayers" type="Node3D" parent="."]
script = ExtResource("3_remote")

[node name="NetClient" type="Node" parent="." node_paths=PackedStringArray("player", "remote_players")]
script = ExtResource("4_client")
player = NodePath("../PlayerRig/Player")
remote_players = NodePath("../RemotePlayers")
join_on_ready = false
