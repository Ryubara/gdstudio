[gd_scene format=3]

[ext_resource type="PackedScene" path="res://world/prototype/prototype_level.tscn" id="1_level"]
[ext_resource type="PackedScene" path="res://gameplay/player/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://gameplay/player/player_camera.gd" id="3_camera"]
[ext_resource type="Script" path="res://addons/phantom_camera/scripts/phantom_camera/phantom_camera_3d.gd" id="4_pcam"]
[ext_resource type="Script" path="res://addons/phantom_camera/scripts/phantom_camera_host/phantom_camera_host.gd" id="5_host"]
[ext_resource type="PackedScene" path="res://ui/touch/third_person_touch_controls.tscn" id="6_touch"]
[ext_resource type="PackedScene" path="res://ui/hud/item_counter.tscn" id="8_counter"]
[ext_resource type="Script" path="res://ui/probe/web_probe.gd" id="10_probe"]
[ext_resource type="Script" path="res://core/audio_settings/audio_settings.gd" id="11_audio"]
[ext_resource type="PackedScene" path="res://ui/hud/crosshair.tscn" id="12_crosshair"]
[ext_resource type="AudioStream" path="res://assets/audio/wind/wind_soft_1.ogg" id="13_wind"]
[ext_resource type="PackedScene" path="res://ui/minimap/minimap_layer.tscn" id="14_minimap"]
[ext_resource type="Script" path="res://core/minimap/minimap_marker.gd" id="15_marker"]
[ext_resource type="Texture2D" path="res://assets/ui/minimap/arrow.png" id="16_arrow"]
[ext_resource type="PackedScene" path="res://gameplay/impacts/impacts.tscn" id="14_impacts"]

[node name="Main" type="Node"]

[node name="AudioSettings" type="Node" parent="."]
script = ExtResource("11_audio")

[node name="Wind" type="AudioStreamPlayer" parent="."]
stream = ExtResource("13_wind")
autoplay = true
volume_db = -20.0
bus = &"Ambient"

[node name="Level" parent="." instance=ExtResource("1_level")]

[node name="Impacts" parent="." instance=ExtResource("14_impacts")]

[node name="Player" parent="." instance=ExtResource("2_player")]

[node name="MinimapMarker" type="Node" parent="Player"]
script = ExtResource("15_marker")
icon = ExtResource("16_arrow")
color = Color(1, 0.84, 0.3, 1)
size = 16.0
rotates_with_node = true
kind = &"player"
draw_order = 5

[node name="PlayerCamera" type="Node3D" parent="." node_paths=PackedStringArray("target", "follow_camera", "camera", "player")]
script = ExtResource("3_camera")
target = NodePath("../Player/CameraTarget")
follow_camera = NodePath("FollowCamera")
camera = NodePath("../Camera")
player = NodePath("../Player")

[node name="FollowCamera" type="Node3D" parent="PlayerCamera" node_paths=PackedStringArray("follow_target")]
script = ExtResource("4_pcam")
follow_mode = 6
follow_target = NodePath("../../Player/CameraTarget")
tween_on_load = false

[node name="Camera" type="Camera3D" parent="."]
current = true
fov = 62.0

[node name="PhantomCameraHost" type="Node" parent="Camera"]
script = ExtResource("5_host")

[node name="TouchControls" parent="." instance=ExtResource("6_touch")]

[node name="Hud" type="CanvasLayer" parent="."]

[node name="ItemCounter" parent="Hud" instance=ExtResource("8_counter")]

[node name="Crosshair" parent="Hud" node_paths=PackedStringArray("player") instance=ExtResource("12_crosshair")]
player = NodePath("../../Player")

[node name="MinimapLayer" parent="." instance=ExtResource("14_minimap")]

[node name="WebProbe" type="Node" parent="." node_paths=PackedStringArray("player", "camera_rig", "touch")]
script = ExtResource("10_probe")
player = NodePath("../Player")
camera_rig = NodePath("../PlayerCamera")
touch = NodePath("../TouchControls")

[connection signal="look_turned" from="TouchControls" to="PlayerCamera" method="orbit"]
